# Copy this file to .env and fill it in. Never commit your real .env (it's in .gitignore).

# PIN for the trainer page (asked once per device). Pick your own, 4-12 digits.
# If you leave it empty, the trainer makes a random 6-digit PIN and prints it in
# `docker logs dragon-trainer`.
TRAINER_PIN=
# Port the iPad/phone opens: http://<your-pc-address>:8677
DRAGON_PORT=8677
# GPU to train on (`nvidia-smi -L` shows UUIDs). An index like 0 also works.
DRAGON_GPU=0
# Where photos, samples and finished LoRAs are stored on the PC
DRAGON_DATA_DIR=./data
# Optional extra folder that receives a copy of each finished LoRA
DRAGON_DELIVER_DIR=./data/deliver
# Your time zone for log timestamps, e.g. America/New_York
TZ=UTC

# Optional: put finished LoRAs straight onto a Draw Things gRPC server (GPL-3.0 add-on, see
# converter/README.md). Uncomment both lines. Use ':' instead of ';' on Linux/macOS.
#COMPOSE_FILE=docker-compose.yml;docker-compose.drawthings.yml
#DT_MODELS_VOLUME=drawthings-models
